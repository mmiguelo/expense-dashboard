# Copy to .env.local (never committed) and fill in from your Supabase project:
# Dashboard > Project Settings > API (or "Connect").
#
# Only the public URL and the anon / publishable key belong here. They end up in the
# JavaScript bundle and are safe to expose because Row Level Security protects the data.
# NEVER put the service_role / secret key here, or anywhere in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
